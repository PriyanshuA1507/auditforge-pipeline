# Example environment variables for AuditForge scan proxy
# Place real secrets in a secure location and DO NOT commit them to source control.

# VirusTotal API key (server-side only)
VIRUSTOTAL_API_KEY=

# Optional: override scan proxy URL used by the frontend during development
# e.g. VITE_SCAN_API_URL=http://localhost:4000/scan
VITE_SCAN_API_URL=http://localhost:4000/scan
